# Backend API base URL (no trailing slash, no /api suffix)
VITE_API_BASE_URL=http://localhost:5000

# Optional request timeout in milliseconds
VITE_API_TIMEOUT=10000

# --- Social login ---
# Google OAuth Client ID (OAuth 2.0 Client ID, "Web application" type)
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 (and your prod domain) to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Apple "Sign in with Apple" Services ID (not the App ID)
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# Apple requires an HTTPS domain registered as a "Website URL" - it will not work on http://localhost.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
